GOOGLE_MAPS_API_KEY=your_key_here
HERE_API_KEY=your_here_api_key_here

# Shared home location
HOME_LAT=51.XXXX
HOME_LON=-0.XXXX

# Per-commuter work locations (order matches commuters[] in commute-schedule.json)
COMMUTER_1_WORK_LAT=51.XXXX
COMMUTER_1_WORK_LON=-0.XXXX
COMMUTER_2_WORK_LAT=51.XXXX
COMMUTER_2_WORK_LON=-0.XXXX

# Drop locations
NURSERY_LAT=51.XXXX
NURSERY_LON=-0.XXXX
DOG_DAYCARE_LAT=51.XXXX
DOG_DAYCARE_LON=-0.XXXX

# Apple iCloud CalDAV
APPLE_CALDAV_URL=https://caldav.icloud.com
APPLE_CALDAV_USERNAME=your_apple_id_email
APPLE_CALDAV_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_CALDAV_CALENDAR_NAME=Family

# Poll interval in seconds (travel and weather loop tick)
POLL_INTERVAL_SECONDS=120

# Travel/calendar poll window — only fetch commute data during this window
POLL_WINDOW_START=06:30
POLL_WINDOW_END=09:30

# Weather poll window end — weather refreshes from POLL_WINDOW_START until this time
# (Open-Meteo is free, no API key required; ~1000 calls/day well within fair-use limits)
# Required — no default
WEATHER_POLL_WINDOW_END=22:00

# How often the calendar is re-fetched within the travel window (seconds)
# Calendar changes rarely; 1800 = every 30 minutes is a sensible value
# Required — no default
CALENDAR_POLL_INTERVAL_SECONDS=1800
